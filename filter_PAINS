# Load input CSV file
input_file = 'thiL_smiles.csv'
df = pd.read_csv(input_file)

# Check if the 'SMILES' column exists
if 'SMILES' in df.columns:
    # The 'SMILES' column exists, proceed with the filtering
    df['IsPains'] = df['SMILES'].apply(filter_pains)
    # Save filtered compounds to output CSV file
    output_file = 'thiL_pains_filter.csv'
    df.to_csv(output_file, index=False)
